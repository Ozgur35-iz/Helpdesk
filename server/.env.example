# Postgres connection string. On Railway, add a Postgres plugin and reference
# its DATABASE_URL variable instead of setting this by hand.
DATABASE_URL="postgresql://postgres@localhost:5432/helpdesk?schema=public"

# Random secret used by better-auth to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The public URL this server is reachable at (used by better-auth for
# cookies/CSRF). In production this is your Railway service's public domain,
# e.g. https://helpdesk-production.up.railway.app
BETTER_AUTH_URL="http://localhost:3001"

# The origin the browser app is served from. Same as BETTER_AUTH_URL in
# production since the server serves the built client itself (see
# client/dist static serving in src/index.ts).
CLIENT_ORIGIN="http://localhost:5173"

# Credentials for the single seeded admin user (server/prisma/seed.ts).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Shared secret the inbound-email webhook checks via the x-webhook-secret
# header (server/src/routes/webhooks.ts).
INBOUND_EMAIL_SECRET=""

# Gemini API key used for classification, auto-resolution, summarize, and
# polish-reply (server/src/lib/ai.ts).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional. Error reporting DSN for @sentry/node. Leave blank to disable.
SENTRY_DSN=""

# Optional. Railway sets PORT automatically — leave unset in production.
# PORT=3001
